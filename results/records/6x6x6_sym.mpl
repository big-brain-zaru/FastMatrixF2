isogroup:=IsotropySubgroup(table([(1)=IsotropyGroupElement([Matrix(6, 6, {NULL}, storage = empty, shape = [identity]), Matrix(6, 6, {NULL}, storage = empty, shape = [identity]), Matrix(6, 6, {NULL}, storage = empty, shape = [identity])],1)]),1,Matrix(1, 1, [[1]]),CyclicGroup(1)):
printf("The original triad\n"):
triad:=Triad([Matrix(6, 6, [[A_1_1,A_1_2,A_1_3,A_1_4,A_1_5,A_1_6],[A_2_1,A_2_2,A_2_3,A_2_4,A_2_5,A_2_6],[A_3_1,A_3_2,A_3_3,A_3_4,A_3_5,A_3_6],[A_4_1,A_4_2,A_4_3,A_4_4,A_4_5,A_4_6],[A_5_1,A_5_2,A_5_3,A_5_4,A_5_5,A_5_6],[A_6_1,A_6_2,A_6_3,A_6_4,A_6_5,A_6_6]]), Matrix(6, 6, [[B_1_1,B_1_2,B_1_3,B_1_4,B_1_5,B_1_6],[B_2_1,B_2_2,B_2_3,B_2_4,B_2_5,B_2_6],[B_3_1,B_3_2,B_3_3,B_3_4,B_3_5,B_3_6],[B_4_1,B_4_2,B_4_3,B_4_4,B_4_5,B_4_6],[B_5_1,B_5_2,B_5_3,B_5_4,B_5_5,B_5_6],[B_6_1,B_6_2,B_6_3,B_6_4,B_6_5,B_6_6]]), Matrix(6, 6, [[C_1_1,C_1_2,C_1_3,C_1_4,C_1_5,C_1_6],[C_2_1,C_2_2,C_2_3,C_2_4,C_2_5,C_2_6],[C_3_1,C_3_2,C_3_3,C_3_4,C_3_5,C_3_6],[C_4_1,C_4_2,C_4_3,C_4_4,C_4_5,C_4_6],[C_5_1,C_5_2,C_5_3,C_5_4,C_5_5,C_5_6],[C_6_1,C_6_2,C_6_3,C_6_4,C_6_5,C_6_6]])]);
IsotropyAction:=proc (ige, triad, $) local IU::Matrix, IV::Matrix, IW::Matrix, triadmatrices::list(Matrix); description "Compute the action of a isotropy on a triad"; if op(2,ige) = 1 then triadmatrices := op(1,triad) elif op(2,ige) = 2 then triadmatrices := map(LinearAlgebra:-Transpose,map(op,[3, 2, 1],op(1,triad))) elif op(2,ige) = 3 then triadmatrices := map(LinearAlgebra:-Transpose,map(op,[2, 1, 3],op(1,triad))) elif op(2,ige) = 4 then triadmatrices := map(op,[3, 1, 2],op(1,triad)) elif op(2,ige) = 5 then triadmatrices := map(op,[2, 3, 1],op(1,triad)) elif op(2,ige) = 6 then triadmatrices := map(LinearAlgebra:-Transpose,map(op,[1, 3, 2],op(1,triad))) else error "This should never happen" end if; if evalb(convert(map(MatrixOptions,op(1,ige),'shape'),set) = {[identity]}) then IU := triadmatrices[1]; IV := triadmatrices[2]; IW := triadmatrices[3] else IU := LinearAlgebra:-Transpose(LinearAlgebra:-MatrixInverse(op([1, 1],ige)),'inplace' = true); IU := LinearAlgebra:-MatrixMatrixMultiply(IU,triadmatrices[1]); IU := LinearAlgebra:-MatrixMatrixMultiply(IU,LinearAlgebra:-Transpose(op([1, 2],ige))); IV := LinearAlgebra:-Transpose(LinearAlgebra:-MatrixInverse(op([1, 2],ige)),'inplace' = true); IV := LinearAlgebra:-MatrixMatrixMultiply(IV,triadmatrices[2]); IV := LinearAlgebra:-MatrixMatrixMultiply(IV,LinearAlgebra:-Transpose(op([1, 3],ige))); IW := LinearAlgebra:-Transpose(LinearAlgebra:-MatrixInverse(op([1, 3],ige)),'inplace' = true); IW := LinearAlgebra:-MatrixMatrixMultiply(IW,triadmatrices[3]); IW := LinearAlgebra:-MatrixMatrixMultiply(IW,LinearAlgebra:-Transpose(op([1, 1],ige))) end if; return Triad([IU, IV, IW]); error "This should never happen" end proc:
:
printf("The action of the second element in isogroup on the original triad is\n"):IsotropyAction(op(1,isogroup)[2],triad);
