# fast-matrix — files kept out of the public repository.
# The complete archive, including everything excluded here, is deposited on Zenodo.

# --- internal campaign notes (day logs, plans, audits) -----------------------
docs/

# --- process output: solver stdout/stderr, not results -----------------------
*.log
*.err
results/**/*.log
results/**/*.err

# --- bulk walker pools (thousands of rank-49/50/55 schemes, ~80 MB) ----------
# Summarised in the papers and in results/*_dissection.json; full pools on Zenodo.
results/g2_444_released_pool.json
results/g2_444_relgated_pool.json
results/g2_444_rk3_pool.json
results/z2_444_pool.json
results/z2_444_rk3_pool.json
results/gated50_pool.json
results/newbasin_49_pool.json
results/B2_worklist.json

# --- machine-specific launchers (hardcode local absolute paths) --------------
# The campaigns were driven by these; they are scaffolding, not results.
experiments/*.ps1
experiments/*.sh

# --- LaTeX auxiliary files ---------------------------------------------------
*.aux
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg

